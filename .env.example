# ==============================================================================
# CAMPUS RIDE SHARING PORTAL — DAFFODIL INTERNATIONAL UNIVERSITY (DIU)
# ==============================================================================

PORT=3000
NODE_ENV=development

# Authentication & JWT Security
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Allowed DIU Email Domain
DIU_EMAIL_DOMAIN=diu.edu.bd

# MySQL Database Settings (TiDB Cloud Starter)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_prefix.root
DB_PASSWORD=your_tidb_password
DB_NAME=diu_campus_ride_sharing
DB_SSL_CA="path/to/isrgrootx1.pem"

# Default Admin Seed Credentials
ADMIN_NAME="DIU Transport Admin"
ADMIN_EMAIL=admin@diu.edu.bd
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_STUDENT_ID=000-00-001
ADMIN_PHONE=01711000001

# Map Tile Provider Configuration (OpenStreetMap default or custom provider)
VITE_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# AI Studio runtime parameters
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"


