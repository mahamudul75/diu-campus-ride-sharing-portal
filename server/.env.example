# ==============================================================================
# SERVER CONFIGURATION — CAMPUS RIDE SHARING PORTAL (DIU)
# ==============================================================================

PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Allowed University Domain
DIU_EMAIL_DOMAIN=diu.edu.bd

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=diu_ride_sharing

# Default Admin Seed Credentials
ADMIN_NAME="DIU Transport Admin"
ADMIN_EMAIL=admin@diu.edu.bd
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_STUDENT_ID=000-00-001
ADMIN_PHONE=01711000001

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
